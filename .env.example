# Groq Cloud API Configuration
# Get your API key from: https://console.groq.com/keys

# ============================================================================
# RECOMMENDED: Google Gemini (250k TPM - Highest free limit!)
# ============================================================================
# Get free API key from: https://aistudio.google.com/apikey
# Run setup script: ./scripts/setup_gemini.sh

GOOGLE_API_KEY=your_google_api_key_here
GROQ_MODEL_NAME=gemini-1.5-flash

# ============================================================================
# ALTERNATIVE: Groq API (20k TPM - Lower limit, may hit rate limits)
# ============================================================================
# Uncomment these and comment out Gemini config above to use Groq instead

# Primary API Key
# GROQ_API_KEY=your_groq_api_key_here

# Model Selection
# Options: llama-3.3-70b-versatile (12k TPM), llama-3.1-8b-instant (20k TPM)
# GROQ_MODEL_NAME=llama-3.1-8b-instant

# Backup API Keys for Rate Limit Rotation (Optional, comma-separated)
# Create multiple keys at https://console.groq.com/keys
# Example: GROQ_API_KEYS_BACKUP=gsk_key2,gsk_key3,gsk_key4
# GROQ_API_KEYS_BACKUP=
